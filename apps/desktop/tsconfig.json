{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Restrict auto-included global @types to what the desktop actually uses.
       Without this, tsc scans every hoisted node_modules/@types entry — including
       the api workspace's deprecated hapi stub types (no index.d.ts) → TS2688. */
    "types": ["node", "react", "react-dom", "better-sqlite3"],

    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "electron", "shared"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
